msgctxt "Addon Summary"
msgid "Kodi Version Check checks if you are running latest released version."
msgstr "Kontrola verze Kodi ověřuje, zda používáte nejnovější vydanou verzi."

msgctxt "Addon Description"
msgid "Kodi Version Check only supports a number of platforms/distros as releases may differ between them. For more information visit the kodi.tv website."
msgstr "Kontrola verze Kodi podporuje jen některé platformy/distribuce, protože se jejich vydání mohou lišit. Další informace najdete na webu kodi.tv."

msgctxt "Addon Disclaimer"
msgid "Feel free to use this script. For information visit kodi.tv"
msgstr "Neváhejte použít tento skript. Další informace najdete na kodi.tv"

msgctxt "#32001"
msgid "We would like to recommend you to upgrade."
msgstr "Doporučujeme provést aktualizaci."

msgctxt "#32002"
msgid "Visit Kodi.tv for more information."
msgstr "Další informace najdete na Kodi.tv."

msgctxt "#32009"
msgid "Would you like to remove this reminder?"
msgstr "Chcete toto připomenutí odstranit?"

msgctxt "#32010"
msgid "You can enable/disable it through add-on settings."
msgstr "Kontrolu můžete zapnout nebo vypnout v nastavení doplňku."

msgctxt "#32011"
msgid "Use your package manager(apt) to upgrade."
msgstr "Použijte k aktualizaci správce balíčků (apt)."

msgctxt "#32012"
msgid "A new version is available, do you want to upgrade now?"
msgstr "Je k dispozici nová verze. Chcete aktualizovat nyní?"

msgctxt "#32013"
msgid "Upgrade successful"
msgstr "Aktualizace byla úspěšná"

msgctxt "#32014"
msgid "Do you want to restart Kodi to finish the upgrade?"
msgstr "Chcete restartovat Kodi, aby se aktualizace dokončila?"

msgctxt "#32015"
msgid "Do you want to check the repository for a new version?"
msgstr "Chcete zkontrolovat, zda je v repozitáři nová verze?"

msgctxt "#32016"
msgid "There is a newer stable Kodi version available."
msgstr "Je k dispozici novější stabilní verze Kodi."

msgctxt "#32020"
msgid "General"
msgstr "Obecné"

msgctxt "#32021"
msgid "Enable Kodi version check?"
msgstr "Kontrolovat verzi Kodi?"

msgctxt "#32022"
msgid "Please enter your password"
msgstr "Zadejte prosím své heslo"

msgctxt "#32023"
msgid "Linux: Upgrade complete system"
msgstr "Linux: Aktualizovat celý systém"

msgctxt "#32024"
msgid "Linux: Upgrade using apt"
msgstr "Linux: Aktualizovat pomocí apt"

#. Used in OK dialog
msgctxt "#32032"
msgid "A new stable version of Kodi is available."
msgstr "Je k dispozici nová stabilní verze Kodi."

#. Direct people to the website. Used in OK dialog
msgctxt "#32033"
msgid "Visit http://kodi.tv for more information."
msgstr "Další informace najdete na http://kodi.tv."

#. For example: "You are using 13.1 prealpha while 13.2 stable is available"
msgctxt "#32034"
msgid "Using %s while %s is available."
msgstr "Používáte %s, ale už je k dispozici %s."

#. Used in OK dialog
msgctxt "#32035"
msgid "It is recommended that you upgrade to a newer version."
msgstr "Doporučujeme aktualizovat na novější verzi."

# empty strings from id 32036 to 32039
msgctxt "#32040"
msgid "Your version %s of the Python cryptography module is too old. You need at least version 1.7."
msgstr "Vaše verze modulu Python cryptography (%s) je příliš stará. Potřebujete alespoň verzi 1.7."

msgctxt "#32041"
msgid "Please upgrade your operating system."
msgstr "Aktualizujte prosím svůj operační systém."

msgctxt "#32042"
msgid "For more information, see https://kodi.wiki/view/Linux"
msgstr "Další informace najdete na https://kodi.wiki/view/Linux"

